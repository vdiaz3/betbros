# ======================= Ford IM – variables de entorno =======================
# Copiar a .env y completar. Nunca subir .env al repositorio.

ACME_EMAIL=admin@menteia.com
APP_SECRET=                       # openssl rand -hex 32  (firma de ligas KYC/firma/banco)
N8N_API_KEY=                      # openssl rand -hex 24  (n8n → api.menteia.com)
ADMIN_API_KEY=                    # openssl rand -hex 24  (métricas, resultado KYC)

# Kioscos: ID:llave separados por coma. El ID debe existir en core/src/data/dealers.json
# Abrir en el panel: https://fordim.menteia.com/k/K-DEMO-01?key=<llave>
KIOSK_KEYS=K-DEMO-01:cambia-esta-llave

QR_ROTATE_SECONDS=30
QR_GRACE_SECONDS=15               # tolerancia para quien escanea justo al cambiar
REF_TTL_MINUTES=30                # tiempo para enviar el primer mensaje de WhatsApp

# --- WhatsApp Cloud API (Meta) ---
WA_DISPLAY_NUMBER=52155XXXXXXXX   # número en formato wa.me, sin "+"
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=                  # token permanente de usuario del sistema
WA_GRAPH_VERSION=v23.0
WA_TEMPLATE_BANK_DECISION=ford_im_respuesta_banco
WA_TEMPLATE_SIGNATURE_DONE=ford_im_firma_completa

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_KIOSK_AGENT_ID=
ELEVENLABS_VOICE_ES=
ELEVENLABS_VOICE_EN=

# --- Google Sheets (Archivo > Compartir > Publicar en la web > CSV, una URL por pestaña) ---
SHEET_VEHICLES_CSV=
SHEET_PRICES_CSV=
SHEET_PROMOS_CSV=

# --- CRM Twenty (crm.menteia.com > Settings > APIs & Webhooks) ---
CRM_BASE_URL=https://crm.menteia.com
CRM_API_KEY=
TWENTY_TAG=                       # fijar una versión, p. ej. la última estable publicada
TWENTY_APP_SECRET=
TWENTY_DB_PASSWORD=
N8N_TAG=                          # sólo si se usa el perfil n8n

# --- KYC ---
KYC_PROVIDER=manual               # manual | webhook
KYC_WEBHOOK_URL=

# --- DocuSign (JWT Grant) ---
DOCUSIGN_AUTH_SERVER=account-d.docusign.com   # producción: account.docusign.com
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
DOCUSIGN_CONNECT_HMAC_KEY=

# --- Correo al banco ---
SMTP_URL=smtps://credito%40menteia.com:PASSWORD@smtp.menteia.com:465
MAIL_FROM="Ford IM <credito@menteia.com>"
MAIL_BCC_DEALER=
BANK_DELIVERY_MODE=attachments    # attachments | secure_link (recomendado)

# --- Avisos legales ---
LEGAL_CONTROLLER_NAME=[RAZÓN SOCIAL DEL DISTRIBUIDOR]
LEGAL_CONTROLLER_ADDRESS=[DOMICILIO]
LEGAL_PRIVACY_EMAIL=privacidad@menteia.com
PRIVACY_NOTICE_VERSION=2026-10-v1
CREDIT_PRIVACY_NOTICE_VERSION=2026-10-v1

# Subdominios (valores por defecto ya apuntan a menteia.com)
# HOST_KIOSK=fordim.menteia.com  HOST_GO=go.menteia.com  HOST_API=api.menteia.com
# HOST_KYC=kyc.menteia.com  HOST_FIRMA=firma.menteia.com  HOST_BANCOS=bancos.menteia.com  HOST_LEGAL=legal.menteia.com
