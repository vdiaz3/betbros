{
  "name": "ford-im-core",
  "version": "0.1.0",
  "private": true,
  "description": "Ford IM \u2013 backend: QR rotativo, sesiones WhatsApp, cr\u00e9dito, KYC, DocuSign, CRM",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "seed:demo": "node --disable-warning=ExperimentalWarning -e \"import('./src/demo/seed.js').then(m => console.log(m.seedDemo({ force: process.argv[1] === '--force' })))\"",
    "build:demo-form": "node scripts/build-demo-form.mjs",
    "check:env": "node --disable-warning=ExperimentalWarning scripts/check-env.mjs",
    "build:datasheets": "node scripts/build-datasheets.mjs",
    "build:videos": "bash scripts/build-placeholder-videos.sh"
  },
  "dependencies": {
    "express": "5.1.0",
    "multer": "2.0.2",
    "nodemailer": "7.0.6",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4"
  }
}
