      "name": "WhatsApp entrante (POST)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        240
      ],
      "webhookId": "e7db3ad3-917d-4fe8-83e4-8e2f6f51f834"
    },
    {
      "parameters": {
        "jsCode": "// Normaliza el payload de WhatsApp Cloud API. Ignora acuses de entrega/lectura.\nconst out = [];\nfor (const item of $input.all()) {\n  const body = item.json.body || item.json;\n  for (const entry of body.entry || []) {\n    for (const change of entry.changes || []) {\n      const v = change.value || {};\n      const names = Object.fromEntries((v.contacts || []).map(c => [c.wa_id, c.profile?.name]));\n      for (const m of v.messages || []) {\n        const media = m.audio || m.voice || m.image || m.document || m.video || null;\n        out.push({ json: {\n          wa_id: m.from,\n          name: names[m.from] || null,\n          message_id: m.id,\n          type: m.type === 'voice' ? 'audio' : m.type,\n          text: m.text?.body || m.button?.text || m.interactive?.button_reply?.title || m.interactive?.list_reply?.title || m.image?.caption || m.document?.caption || '',\n          media_id: media?.id || null,\n          mime: media?.mime_type || null,\n        }});\n      }\n    }\n  }\n}\nreturn out;"
      },
      "id": "c093c7f6-6edf-595e-9539-70de788efbaa",
      "name": "Normalizar mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
